# ---- core ----
DATABASE_URL=postgresql://admeasy:admeasy@localhost:5432/admeasy
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_API_KEY=                             # defaults to SARVAM_API_KEY when empty
LLM_MODEL=sarvam-105b
# Background deep-agent tasks. Key in the llms map. "claude" uses Bedrock Sonnet (legacy key: groq).
DEEP_LLM_PROVIDER=sarvam
# AWS Bedrock Claude (Pro chat + optional deep/VM). Standard AWS_* creds on Lightsail.
BEDROCK_REGION=ap-south-1
BEDROCK_CHAT_MODEL_ID=apac.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_DEEP_MODEL_ID=apac.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_VM_MODEL_ID=apac.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional legacy OpenAI-compatible chat (not required for boot).
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# VM screenshot + computer-use vision. Default Bedrock (AWS creds). Set groq + VM_VISION_API_KEY to use Groq.
VM_VISION_PROVIDER=bedrock
VM_BEDROCK_COMPUTER_USE=true
VM_VISION_API_KEY=
VM_VISION_BASE_URL=https://api.groq.com/openai/v1
VM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
EMBEDDING_BASE_URL=                      # OpenAI-compatible /embeddings (e.g. self-hosted multilingual-e5-small, 384-d)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=384
MCP_SERVERS_FILE=config/mcp_servers.json
CONTEXT_TOKEN_CAP=6000
LAST_N_TURNS=6
MEMORY_TOP_K=5
MEMORY_TOKEN_CAP=800

# ---- Phase 2: OAuth + integrations ----
TOKEN_ENCRYPTION_KEYS=                   # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Public HTTPS base for OAuth + MCP DCR. Use a short custom domain in production (see deploy/aws/README.md).
# Redirect URIs:
#   $PUBLIC_BASE_URL/oauth/google/callback
#   $PUBLIC_BASE_URL/oauth/zoho/callback
#   $PUBLIC_BASE_URL/oauth/slack/callback
#   $PUBLIC_BASE_URL/mcp/oauth/callback   (all DCR remote MCP servers)
# Federated MCP host for external clients: $PUBLIC_BASE_URL/mcp/v1/ (Bearer Admeasy JWT)
PUBLIC_BASE_URL=http://localhost:8000
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_MCP_ENABLED=false
GOOGLE_WORKSPACE_MCP_URL=http://localhost:8001/mcp
# MCP marketplace host (first-party servers: slack, zoho, razorpay, …)
MCP_HOST_URL=http://localhost:8100
MCP_HOST_SECRET=
# Optional hosted Zoho MCP console URLs
ZOHO_MCP_URL=
ZOHO_CRM_MCP_URL=
SLACK_ENABLED=false
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
WEBSITE_MCP_ENABLED=false
ZOHO_ENABLED=false
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=                   # Meta system-user permanent token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=

# ---- developer MCP (GitHub + Supabase) ----
# People connect their own token:
#   POST /oauth/github/token?user_id=...     {"access_token":"<github pat>"}
#   POST /oauth/supabase/token?user_id=...   {"access_token":"<supabase pat>"}
# A token set here is the fallback until that user connects their own.
GITHUB_MCP_ENABLED=false
GITHUB_PERSONAL_ACCESS_TOKEN=
SUPABASE_MCP_ENABLED=false
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Assistant-project Storage for chat artifacts (any file type the user uploads, plus generated files).
# This is the assistant project, not the project ref above. Leave the URL empty to keep files on local disk.
# SUPABASE_SERVICE_ROLE_KEY stays on the server. Never ship it in the mobile app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# POST /auth/password. Anon or publishable key sent as the Supabase password grant.
# Not the service role key. Never log this value.
SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=   # used when SUPABASE_ANON_KEY is empty
SUPABASE_STORAGE_BUCKET=artifacts
# Public bucket for a site the agent publishes (phone-openable URL). Not the private artifacts bucket.
SITES_BUCKET=sites
# Optional fallback deploy token until the user connects their own. Never log it.
VERCEL_TOKEN=
# Finished background jobs post in chat. If the phone is not on the socket, FCM HTTP v1 pushes
# the result. FCM_SERVER_KEY is no longer used.
# FIREBASE_PROJECT_ID is the Firebase project (admeasy-ai-assistant).
# FIREBASE_SERVICE_ACCOUNT_JSON is the full service-account JSON, one object. Never log it.
FIREBASE_PROJECT_ID=admeasy-ai-assistant
FIREBASE_SERVICE_ACCOUNT_JSON=
# Upload ceiling and resumable chunk size, in bytes. Defaults: 100 MB and 4 MB.
ADMEASY_ARTIFACT_MAX_BYTES=104857600
ADMEASY_ARTIFACT_CHUNK_BYTES=4194304

# ---- LangChain / LangSmith ----
# The agent calls the LLM through LangChain (OpenAI-compatible LLM_BASE_URL, Sarvam by default).
# Tracing turns on when LANGCHAIN_TRACING=true or LANGSMITH_API_KEY is set.
LANGCHAIN_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=admeasy
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Forced on at process start. Traces must not include prompts or completions.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# ---- Phase 3: voice ----
SARVAM_API_KEY=
STT_MODEL=saaras:v3-realtime
TTS_MODEL=bulbul:v4-flash
TTS_SPEAKER=
TTS_CODEC=mp3
DEFAULT_LANGUAGE=hi-IN

# --- Local computers (desktop app .dmg / .exe) ---
# Lets the signed-in phone control the user's own Mac/Windows machine through device_* tools. Needs Postgres.
DEVICES_ENABLED=false
